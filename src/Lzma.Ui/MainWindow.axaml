<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Lzma.Ui.ViewModels"
        xmlns:models="using:Lzma.Ui.Models"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="Lzma.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Тулбар -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ThemeBorderMidBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Открыть…" Command="{Binding OpenCommand}" />
                <Button Content="Открыть большой архив…" Command="{Binding OpenArchiveFileCommand}"
                        ToolTip.Tip="Обзор .7z по пути без загрузки в память (для архивов больше 2 ГиБ)" />
                <Button Content="Создать…" Command="{Binding CreateCommand}"
                        IsVisible="{Binding CanCreate}" />
                <Button Content="Создать из папки…" Command="{Binding CreateFromFolderCommand}"
                        IsVisible="{Binding CanCreateFromFolder}" />
                <ComboBox ItemsSource="{Binding CompressionMethods}"
                          SelectedValue="{Binding SelectedCompressionMethod}"
                          SelectedValueBinding="{Binding Method}"
                          IsVisible="{Binding CanCreate}"
                          VerticalAlignment="Center" MinWidth="190"
                          ToolTip.Tip="Метод сжатия для создаваемого архива">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:CompressionMethodOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding ThreadCountOptions}"
                          SelectedValue="{Binding SelectedThreadCount}"
                          SelectedValueBinding="{Binding Value}"
                          IsVisible="{Binding CanCreate}"
                          VerticalAlignment="Center" MinWidth="150"
                          ToolTip.Tip="Число потоков сжатия (меньше — система отзывчивее)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ThreadCountOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding DictionarySizeOptions}"
                          SelectedValue="{Binding SelectedDictionarySize}"
                          SelectedValueBinding="{Binding Bytes}"
                          IsVisible="{Binding CanCreate}"
                          VerticalAlignment="Center" MinWidth="170"
                          ToolTip.Tip="Размер словаря LZMA2 (больше — лучше сжатие, но больше памяти)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DictionarySizeOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Извлечь всё…" Command="{Binding ExtractAllCommand}" />
                <Button Content="Извлечь архив с диска…" Command="{Binding ExtractArchiveFileCommand}"
                        ToolTip.Tip="Извлечь .7z прямо с диска потоком, без загрузки в память (для архивов больше 2 ГиБ)" />
                <Button Content="Вверх" Command="{Binding NavigateUpCommand}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                             Width="120" VerticalAlignment="Center"
                             IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                           VerticalAlignment="Center" Foreground="Gray" Width="38"
                           IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center"
                           Foreground="Gray" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding ProgressEta}" VerticalAlignment="Center"
                           Foreground="Gray" IsVisible="{Binding IsBusy}" />
                <!-- Имя файла, сжимаемого прямо сейчас (как в 7-Zip). -->
                <TextBlock Text="{Binding CurrentFileStatus}" VerticalAlignment="Center"
                           Foreground="Gray" TextTrimming="CharacterEllipsis" MaxWidth="260"
                           IsVisible="{Binding CurrentFileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Content="Отмена" Command="{Binding CancelCommand}"
                        VerticalAlignment="Center" IsVisible="{Binding IsCancelVisible}" />
                <!-- Живой счётчик на фазе сканирования/чтения файлов (до сжатия). -->
                <ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center"
                             IsVisible="{Binding IsScanning}" />
                <TextBlock Text="{Binding ScanStatus}" VerticalAlignment="Center"
                           Foreground="Gray" IsVisible="{Binding IsScanning}" />
                <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center"
                           Foreground="Gray" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsBusy}" />
            </StackPanel>
        </Border>

        <!-- Статусная строка (выделяемая — можно скопировать диагностику) -->
        <Border DockPanel.Dock="Bottom" Padding="8,6" MaxHeight="120"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="Gray" />
            </ScrollViewer>
        </Border>

        <!-- Содержимое -->
        <Panel>
            <!-- Пустое состояние -->
            <TextBlock Text="Откройте архив для просмотра — или соберите новый кнопкой «Создать…»."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" Margin="24"
                       IsVisible="{Binding !HasArchive}" />

            <!-- Таблица содержимого -->
            <Grid IsVisible="{Binding HasArchive}" RowDefinitions="Auto,*">

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0" Padding="14,6" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                        Background="{DynamicResource ThemeBackgroundBrush}">
                    <Grid ColumnDefinitions="24,*,120,90">
                        <TextBlock Grid.Column="1" Text="Имя" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Размер" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Тип" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                         SelectionMode="Single"
                         DoubleTapped="OnItemDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ArchiveItem">
                            <Grid ColumnDefinitions="24,*,120,90">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Foreground="Gray" />
                                <TextBlock Grid.Column="3" Text="{Binding Kind}" Foreground="Gray" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Panel>

    </DockPanel>
</Window>
