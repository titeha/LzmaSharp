<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Lzma.Ui.ViewModels"
        xmlns:models="using:Lzma.Ui.Models"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="Lzma.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="{DynamicResource AppUiFont}">

    <Window.Styles>
        <!-- Иконочные кнопки тулбара: квадратный отступ, иконка 18px (красится Foreground кнопки). -->
        <Style Selector="Button.tool">
            <Setter Property="Padding" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Тулбар -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppHairline}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="tool" Command="{Binding OpenCommand}"
                        ToolTip.Tip="Открыть архив 7z/ZIP: небольшой — целиком, большой (&gt;2 ГиБ / ZIP64) — потоково">
                    <PathIcon Data="{StaticResource IconOpen}" />
                </Button>
                <Button Classes="tool accent" Click="OnOpenCreateWindow"
                        IsVisible="{Binding CanCreate}"
                        ToolTip.Tip="Создать архив: настройки сжатия и сборка в отдельном окне">
                    <PathIcon Data="{StaticResource IconCreate}" />
                </Button>
                <!-- Настройки сжатия (метод/потоки/словарь/тома) переехали в окно «Создать архив».
                     Извлечение (открытый архив / архив с диска) — в окне «Извлечь…». -->
                <Button Classes="tool" Click="OnOpenExtractWindow"
                        ToolTip.Tip="Извлечь открытый архив или архив с диска в отдельном окне">
                    <PathIcon Data="{StaticResource IconExtract}" />
                </Button>
                <Button Classes="tool" Command="{Binding NavigateUpCommand}"
                        IsVisible="{Binding HasArchive}"
                        ToolTip.Tip="Вверх — на уровень выше (или выход из архива)">
                    <PathIcon Data="{StaticResource IconUp}" />
                </Button>
                <Button Classes="tool" Click="OnOpenArchiveInfo"
                        IsVisible="{Binding HasArchive}"
                        ToolTip.Tip="Информация об архиве: коэффициент сжатия, размеры, число файлов">
                    <PathIcon Data="{StaticResource IconStats}" />
                </Button>
                <Button Classes="tool" Click="OnToggleTheme"
                        ToolTip.Tip="Переключить тему (тёмная/светлая)">
                    <PathIcon Data="{StaticResource IconTheme}" />
                </Button>
                <Button Classes="tool" Click="OnOpenAbout"
                        ToolTip.Tip="О программе">
                    <PathIcon Data="{StaticResource IconInfo}" />
                </Button>
                <!-- Адресная строка: крошки (архив) ↔ кликабельное поле адреса (ФС) ↔ поле ввода пути.
                     Весь блок скрыт во время операции (IsBusy). -->
                <Panel VerticalAlignment="Center" IsVisible="{Binding !IsBusy}">
                <!-- Режим архива: кликабельные крошки навигации. -->
                <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center"
                              IsVisible="{Binding HasArchive}">
                    <ItemsControl.Styles>
                        <Style Selector="Button.crumb">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Foreground" Value="{DynamicResource AppInkSecondary}" />
                        </Style>
                        <Style Selector="Button.crumb.current">
                            <Setter Property="Foreground" Value="{DynamicResource AppCopper}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:PathCrumb">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding Name}" Classes="crumb"
                                        Classes.current="{Binding IsCurrent}"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).NavigateToCrumbCommand}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="›" VerticalAlignment="Center" Margin="1,0"
                                           Foreground="{DynamicResource AppHairline}"
                                           IsVisible="{Binding !IsCurrent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                  <!-- Режим ФС: кликабельное поле адреса (клик по строке → ввод пути, как в проводнике). -->
                  <Border IsVisible="{Binding ShowAddressField}" PointerPressed="OnEditPath" Cursor="Hand"
                          Background="{DynamicResource AppSurfaceRaised}" BorderBrush="{DynamicResource AppHairline}"
                          BorderThickness="1" CornerRadius="4" Padding="9,4" MinWidth="280"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Кликните, чтобы ввести путь и перейти (как в проводнике)">
                      <TextBlock Text="{Binding AddressText}" Foreground="{DynamicResource AppInkSecondary}"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Border>
                  <!-- Режим ввода пути: Enter — перейти, Esc/уход фокуса — отмена. -->
                  <TextBox x:Name="PathBox" IsVisible="{Binding IsEditingPath}" MinWidth="380"
                           Text="{Binding EditablePath}" Watermark="Введите путь и нажмите Enter…"
                           VerticalAlignment="Center" LostFocus="OnPathBoxLostFocus">
                      <TextBox.KeyBindings>
                          <KeyBinding Gesture="Enter" Command="{Binding CommitPathCommand}" />
                          <KeyBinding Gesture="Escape" Command="{Binding CancelEditPathCommand}" />
                      </TextBox.KeyBindings>
                  </TextBox>
                </Panel>
                <TextBlock Text="{Binding SelectedCount, StringFormat='• Выбрано: {0}'}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppCopper}" FontFamily="{DynamicResource AppMonoFont}"
                           IsVisible="{Binding HasSelection}" />
            </StackPanel>
        </Border>

        <!-- Нижняя панель: строка прогресса (градусник/проценты/счётчик/текущий файл/ETA/отмена)
             и статусная строка (выделяемая — можно скопировать диагностику). -->
        <Border DockPanel.Dock="Bottom" Padding="8,6" BorderThickness="0,1,0,0"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppHairline}"
                IsVisible="{Binding IsBottomBarVisible}">
            <StackPanel Spacing="6">

                <!-- Прогресс/скан: видна во время операции или сканирования. -->
                <WrapPanel IsVisible="{Binding IsCancelVisible}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Width="180" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Foreground="{DynamicResource AppCopper}"
                                 IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                               VerticalAlignment="Center" Foreground="{DynamicResource AppCopper}" Width="40" Margin="0,0,8,0"
                               FontFamily="{DynamicResource AppMonoFont}" FontWeight="SemiBold"
                               IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInk}" FontFamily="{DynamicResource AppMonoFont}"
                               IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressEta}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" FontFamily="{DynamicResource AppMonoFont}"
                               IsVisible="{Binding IsBusy}" />
                    <!-- Имя файла, сжимаемого/извлекаемого прямо сейчас (как в 7-Zip). -->
                    <TextBlock Text="{Binding CurrentFileStatus}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                               IsVisible="{Binding CurrentFileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Живой счётчик на фазе сканирования/чтения файлов (до сжатия). -->
                    <ProgressBar IsIndeterminate="True" Width="180" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                 IsVisible="{Binding IsScanning}" />
                    <TextBlock Text="{Binding ScanStatus}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" IsVisible="{Binding IsScanning}" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            VerticalAlignment="Center" IsVisible="{Binding IsCancelVisible}" />
                </WrapPanel>

                <!-- Открытие/обзор архива: индикатор занятости сразу (открытие не выглядит зависанием). -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOpening}">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="16" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AppCopper}" />
                    <TextBlock Text="Открываю архив…" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppInkSecondary}" />
                </StackPanel>

                <!-- Статус (итоги/диагностика). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="120"
                              IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AppInkSecondary}" />
                </ScrollViewer>

            </StackPanel>
        </Border>

        <!-- Содержимое -->
        <Panel>
            <!-- Пустое состояние (когда нет ни архива, ни браузера ФС) -->
            <TextBlock Text="Откройте архив для просмотра — или соберите новый кнопкой «Создать архив…»."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppInkSecondary}" Margin="24"
                       IsVisible="{Binding !HasContent}" />

            <!-- Таблица содержимого (архив или файловая система) — «карточка»: рамка+фон+скругление
                 отделяют браузер от тулбара/фона окна. -->
            <Border IsVisible="{Binding HasContent}" Margin="12"
                    CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppCopper}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">

                    <!-- Заголовок таблицы (колонки) — только в режиме архива (плоский список). -->
                    <Border Grid.Row="0" Padding="14,7" BorderThickness="0,0,0,1"
                            IsVisible="{Binding HasArchive}"
                            BorderBrush="{DynamicResource AppHairline}"
                            Background="{DynamicResource AppSurfaceRaised}">
                        <Grid ColumnDefinitions="28,24,*,120,90">
                            <TextBlock Grid.Column="2" Text="Имя" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppInkSecondary}" />
                            <TextBlock Grid.Column="3" Text="Размер" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppInkSecondary}" />
                            <TextBlock Grid.Column="4" Text="Тип" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppInkSecondary}" />
                        </Grid>
                    </Border>

                    <!-- Режим архива: плоский список текущей папки. -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                             SelectionMode="Single" Background="Transparent" BorderThickness="0"
                             IsVisible="{Binding HasArchive}"
                             DoubleTapped="OnItemDoubleTapped">
                        <!-- Плотные строки: убираем крупные Fluent-отступы ListBoxItem, ведём свой ритм. -->
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="14,4" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ArchiveItem">
                                <Grid ColumnDefinitions="28,24,*,120,90">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Padding="0" MinWidth="0"
                                              ToolTip.Tip="Отметить для действий (создать архив, …)" />
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16"
                                                  Foreground="{DynamicResource AppSteel}" IsVisible="{Binding IsDirectory}" />
                                        <PathIcon Data="{StaticResource IconArchive}" Width="16" Height="16"
                                                  Foreground="{DynamicResource AppCopper}" IsVisible="{Binding IsArchiveFile}" />
                                        <PathIcon Data="{StaticResource IconFile}" Width="16" Height="16"
                                                  Foreground="{DynamicResource AppInkSecondary}" IsVisible="{Binding IsPlainFile}" />
                                    </Panel>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding DisplaySize}" Foreground="{DynamicResource AppInkSecondary}"
                                               FontFamily="{DynamicResource AppMonoFont}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Kind}" Foreground="{DynamicResource AppInkSecondary}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Режим браузера ФС: раскрываемое дерево от дисков (ленивая догрузка при раскрытии). -->
                    <TreeView Grid.Row="1" ItemsSource="{Binding FileSystemTree}"
                              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}"
                              Background="Transparent" BorderThickness="0"
                              IsVisible="{Binding IsFileSystemMode}"
                              DoubleTapped="OnTreeNodeDoubleTapped">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem">
                                <!-- DataContext контейнера — TreeNodeItem; в стиле компилируемая привязка
                                     резолвится против VM, поэтому здесь рефлексивная. -->
                                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="2,3" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" DataType="models:TreeNodeItem">
                                <Grid ColumnDefinitions="24,22,*,Auto" VerticalAlignment="Center">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Padding="0" MinWidth="0"
                                              ToolTip.Tip="Отметить для создания архива" />
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15"
                                                  Foreground="{DynamicResource AppSteel}" IsVisible="{Binding IsDirectory}" />
                                        <PathIcon Data="{StaticResource IconArchive}" Width="15" Height="15"
                                                  Foreground="{DynamicResource AppCopper}" IsVisible="{Binding IsArchiveFile}" />
                                        <PathIcon Data="{StaticResource IconFile}" Width="15" Height="15"
                                                  Foreground="{DynamicResource AppInkSecondary}" IsVisible="{Binding IsPlainFile}" />
                                    </Panel>
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding DisplaySize}" Margin="8,0,4,0"
                                               Foreground="{DynamicResource AppInkSecondary}"
                                               FontFamily="{DynamicResource AppMonoFont}" VerticalAlignment="Center" />
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
        </Panel>

    </DockPanel>
</Window>
