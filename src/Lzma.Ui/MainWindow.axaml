<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Lzma.Ui.ViewModels"
        xmlns:models="using:Lzma.Ui.Models"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="Lzma.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="{DynamicResource AppUiFont}">

    <DockPanel>

        <!-- Тулбар -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppHairline}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Открыть…" Command="{Binding OpenCommand}"
                        ToolTip.Tip="Открыть архив 7z/ZIP: небольшой — целиком, большой (&gt;2 ГиБ / ZIP64) — потоково" />
                <Button Content="Создать архив…" Click="OnOpenCreateWindow" Classes="accent"
                        IsVisible="{Binding CanCreate}"
                        ToolTip.Tip="Настройки сжатия и создание архива в отдельном окне" />
                <!-- Настройки сжатия (метод/потоки/словарь/тома) переехали в окно «Создать архив».
                     Извлечение (открытый архив / архив с диска) — в окне «Извлечь…». -->
                <Button Content="Извлечь…" Click="OnOpenExtractWindow"
                        ToolTip.Tip="Извлечь открытый архив или архив с диска в отдельном окне" />
                <Button Content="Вверх" Command="{Binding NavigateUpCommand}" />
                <Button Content="◐" Click="OnToggleTheme" VerticalAlignment="Center"
                        ToolTip.Tip="Переключить тему (тёмная/светлая)" />
                <!-- Хлебные крошки текущего пути: каждый сегмент кликабелен для перехода на его уровень.
                     Последний сегмент (IsCurrent) подсвечен медью, разделитель после него скрыт. -->
                <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center"
                              IsVisible="{Binding !IsBusy}">
                    <ItemsControl.Styles>
                        <Style Selector="Button.crumb">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Foreground" Value="{DynamicResource AppInkSecondary}" />
                        </Style>
                        <Style Selector="Button.crumb.current">
                            <Setter Property="Foreground" Value="{DynamicResource AppCopper}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:PathCrumb">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding Name}" Classes="crumb"
                                        Classes.current="{Binding IsCurrent}"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).NavigateToCrumbCommand}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="›" VerticalAlignment="Center" Margin="1,0"
                                           Foreground="{DynamicResource AppHairline}"
                                           IsVisible="{Binding !IsCurrent}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SelectedCount, StringFormat='• Выбрано: {0}'}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppCopper}" FontFamily="{DynamicResource AppMonoFont}"
                           IsVisible="{Binding HasSelection}" />
            </StackPanel>
        </Border>

        <!-- Нижняя панель: строка прогресса (градусник/проценты/счётчик/текущий файл/ETA/отмена)
             и статусная строка (выделяемая — можно скопировать диагностику). -->
        <Border DockPanel.Dock="Bottom" Padding="8,6" BorderThickness="0,1,0,0"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppHairline}"
                IsVisible="{Binding IsBottomBarVisible}">
            <StackPanel Spacing="6">

                <!-- Прогресс/скан: видна во время операции или сканирования. -->
                <WrapPanel IsVisible="{Binding IsCancelVisible}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Width="180" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Foreground="{DynamicResource AppCopper}"
                                 IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                               VerticalAlignment="Center" Foreground="{DynamicResource AppCopper}" Width="40" Margin="0,0,8,0"
                               FontFamily="{DynamicResource AppMonoFont}" FontWeight="SemiBold"
                               IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInk}" FontFamily="{DynamicResource AppMonoFont}"
                               IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressEta}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" FontFamily="{DynamicResource AppMonoFont}"
                               IsVisible="{Binding IsBusy}" />
                    <!-- Имя файла, сжимаемого/извлекаемого прямо сейчас (как в 7-Zip). -->
                    <TextBlock Text="{Binding CurrentFileStatus}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                               IsVisible="{Binding CurrentFileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Живой счётчик на фазе сканирования/чтения файлов (до сжатия). -->
                    <ProgressBar IsIndeterminate="True" Width="180" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                 IsVisible="{Binding IsScanning}" />
                    <TextBlock Text="{Binding ScanStatus}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" IsVisible="{Binding IsScanning}" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            VerticalAlignment="Center" IsVisible="{Binding IsCancelVisible}" />
                </WrapPanel>

                <!-- Открытие/обзор архива: индикатор занятости сразу (открытие не выглядит зависанием). -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOpening}">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="16" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AppCopper}" />
                    <TextBlock Text="Открываю архив…" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppInkSecondary}" />
                </StackPanel>

                <!-- Статус (итоги/диагностика). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="120"
                              IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AppInkSecondary}" />
                </ScrollViewer>

            </StackPanel>
        </Border>

        <!-- Содержимое -->
        <Panel>
            <!-- Пустое состояние (когда нет ни архива, ни браузера ФС) -->
            <TextBlock Text="Откройте архив для просмотра — или соберите новый кнопкой «Создать архив…»."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppInkSecondary}" Margin="24"
                       IsVisible="{Binding !HasContent}" />

            <!-- Таблица содержимого (архив или файловая система) — «карточка»: рамка+фон+скругление
                 отделяют браузер от тулбара/фона окна. -->
            <Border IsVisible="{Binding HasContent}" Margin="12"
                    CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppCopper}" BorderThickness="1">
                <Grid RowDefinitions="Auto,*">

                    <!-- Заголовок таблицы -->
                    <Border Grid.Row="0" Padding="14,7" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource AppHairline}"
                            Background="{DynamicResource AppSurfaceRaised}">
                        <Grid ColumnDefinitions="28,24,*,120,90">
                            <TextBlock Grid.Column="2" Text="Имя" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppInkSecondary}" />
                            <TextBlock Grid.Column="3" Text="Размер" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppInkSecondary}" />
                            <TextBlock Grid.Column="4" Text="Тип" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AppInkSecondary}" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                             SelectionMode="Single" Background="Transparent" BorderThickness="0"
                             DoubleTapped="OnItemDoubleTapped">
                        <!-- Плотные строки: убираем крупные Fluent-отступы ListBoxItem, ведём свой ритм. -->
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="14,4" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ArchiveItem">
                                <Grid ColumnDefinitions="28,24,*,120,90">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Padding="0" MinWidth="0"
                                              ToolTip.Tip="Отметить для действий (создать архив, …)" />
                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding DisplaySize}" Foreground="{DynamicResource AppInkSecondary}"
                                               FontFamily="{DynamicResource AppMonoFont}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding Kind}" Foreground="{DynamicResource AppInkSecondary}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Panel>

    </DockPanel>
</Window>
