<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Lzma.Ui.ViewModels"
        xmlns:models="using:Lzma.Ui.Models"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="Lzma.Ui.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="900" Height="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBg}"
        FontFamily="{DynamicResource AppUiFont}">

    <DockPanel>

        <!-- Тулбар -->
        <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppHairline}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Открыть…" Command="{Binding OpenCommand}" />
                <Button Content="Открыть большой архив…" Command="{Binding OpenArchiveFileCommand}"
                        ToolTip.Tip="Обзор .7z по пути без загрузки в память (для архивов больше 2 ГиБ)" />
                <Button Content="Создать…" Command="{Binding CreateCommand}"
                        Classes="accent"
                        IsVisible="{Binding CanCreate}" />
                <Button Content="Создать из папки…" Command="{Binding CreateFromFolderCommand}"
                        IsVisible="{Binding CanCreateFromFolder}" />
                <ComboBox ItemsSource="{Binding CompressionMethods}"
                          SelectedValue="{Binding SelectedCompressionMethod}"
                          SelectedValueBinding="{Binding Method}"
                          IsVisible="{Binding CanCreate}"
                          VerticalAlignment="Center" MinWidth="190"
                          ToolTip.Tip="Метод сжатия для создаваемого архива">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:CompressionMethodOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding ThreadCountOptions}"
                          SelectedValue="{Binding SelectedThreadCount}"
                          SelectedValueBinding="{Binding Value}"
                          IsVisible="{Binding CanCreate}"
                          VerticalAlignment="Center" MinWidth="150"
                          ToolTip.Tip="Число потоков сжатия (меньше — система отзывчивее)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ThreadCountOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding DictionarySizeOptions}"
                          SelectedValue="{Binding SelectedDictionarySize}"
                          SelectedValueBinding="{Binding Bytes}"
                          IsVisible="{Binding CanCreate}"
                          VerticalAlignment="Center" MinWidth="170"
                          ToolTip.Tip="Размер словаря LZMA2 (больше — лучше сжатие, но больше памяти)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:DictionarySizeOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding VolumeSizeOptions}"
                          SelectedValue="{Binding SelectedVolumeSize}"
                          SelectedValueBinding="{Binding Bytes}"
                          IsVisible="{Binding CanCreate}"
                          VerticalAlignment="Center" MinWidth="170"
                          ToolTip.Tip="Разбить архив на тома (.001/.002/…); открывается выбором первого тома">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:VolumeSizeOption">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Извлечь всё…" Command="{Binding ExtractAllCommand}" />
                <Button Content="Извлечь архив с диска…" Command="{Binding ExtractArchiveFileCommand}"
                        ToolTip.Tip="Извлечь .7z прямо с диска потоком, без загрузки в память (для архивов больше 2 ГиБ)" />
                <Button Content="Вверх" Command="{Binding NavigateUpCommand}" />
                <Button Content="◐" Click="OnToggleTheme" VerticalAlignment="Center"
                        ToolTip.Tip="Переключить тему (тёмная/светлая)" />
                <TextBlock Text="{Binding CurrentPath}" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppInkSecondary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding !IsBusy}" />
            </StackPanel>
        </Border>

        <!-- Нижняя панель: строка прогресса (градусник/проценты/счётчик/текущий файл/ETA/отмена)
             и статусная строка (выделяемая — можно скопировать диагностику). -->
        <Border DockPanel.Dock="Bottom" Padding="8,6" BorderThickness="0,1,0,0"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppHairline}"
                IsVisible="{Binding IsBottomBarVisible}">
            <StackPanel Spacing="6">

                <!-- Прогресс/скан: видна во время операции или сканирования. -->
                <WrapPanel IsVisible="{Binding IsCancelVisible}">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                                 Width="180" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                 Foreground="{DynamicResource AppCopper}"
                                 IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"
                               VerticalAlignment="Center" Foreground="{DynamicResource AppCopper}" Width="40" Margin="0,0,8,0"
                               FontFamily="{DynamicResource AppMonoFont}" FontWeight="SemiBold"
                               IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInk}" FontFamily="{DynamicResource AppMonoFont}"
                               IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="{Binding ProgressEta}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" FontFamily="{DynamicResource AppMonoFont}"
                               IsVisible="{Binding IsBusy}" />
                    <!-- Имя файла, сжимаемого/извлекаемого прямо сейчас (как в 7-Zip). -->
                    <TextBlock Text="{Binding CurrentFileStatus}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                               IsVisible="{Binding CurrentFileStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- Живой счётчик на фазе сканирования/чтения файлов (до сжатия). -->
                    <ProgressBar IsIndeterminate="True" Width="180" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                 IsVisible="{Binding IsScanning}" />
                    <TextBlock Text="{Binding ScanStatus}" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AppInkSecondary}" IsVisible="{Binding IsScanning}" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}"
                            VerticalAlignment="Center" IsVisible="{Binding IsCancelVisible}" />
                </WrapPanel>

                <!-- Статус (итоги/диагностика). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="120"
                              IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AppInkSecondary}" />
                </ScrollViewer>

            </StackPanel>
        </Border>

        <!-- Содержимое -->
        <Panel>
            <!-- Пустое состояние -->
            <TextBlock Text="Откройте архив для просмотра — или соберите новый кнопкой «Создать…»."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource AppInkSecondary}" Margin="24"
                       IsVisible="{Binding !HasArchive}" />

            <!-- Таблица содержимого -->
            <Grid IsVisible="{Binding HasArchive}" RowDefinitions="Auto,*">

                <!-- Заголовок таблицы -->
                <Border Grid.Row="0" Padding="14,6" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource AppHairline}"
                        Background="{DynamicResource AppSurfaceRaised}">
                    <Grid ColumnDefinitions="24,*,120,90">
                        <TextBlock Grid.Column="1" Text="Имя" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Размер" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Тип" FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                         SelectionMode="Single"
                         DoubleTapped="OnItemDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ArchiveItem">
                            <Grid ColumnDefinitions="24,*,120,90">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Foreground="{DynamicResource AppInkSecondary}"
                                           FontFamily="{DynamicResource AppMonoFont}" />
                                <TextBlock Grid.Column="3" Text="{Binding Kind}" Foreground="{DynamicResource AppInkSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Panel>

    </DockPanel>
</Window>
