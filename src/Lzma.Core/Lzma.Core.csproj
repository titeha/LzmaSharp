<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet-пакет: Ti-Soft.LzmaSharp -->
  <PropertyGroup>
    <PackageId>Ti-Soft.LzmaSharp</PackageId>
    <Version>0.1.0</Version>
    <Authors>Artemy Sobolev</Authors>
    <Company>Ti-Soft</Company>
    <Product>LzmaSharp</Product>
    <Description>Чисто управляемая (100% managed, без нативных зависимостей и unsafe) реализация 7z/LZMA для .NET: чтение И запись .7z, кодеки LZMA, LZMA2, PPMd, фильтр BCJ2, шифрование 7zAES (AES-256), экспериментальный ГОСТ, многотомные архивы, потоковые API для файлов больше 2 ГиБ. Совместимо с настоящим 7-Zip. Не обёртка над 7z.dll.</Description>
    <Copyright>Copyright (c) 2025-2026 Artemy Sobolev (Ti-Soft)</Copyright>
    <PackageTags>7z;7zip;lzma;lzma2;ppmd;bcj2;aes;gost;compression;archive;managed;encoder;decoder</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/titeha/LzmaSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/titeha/LzmaSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: не требуем XML-док у КАЖДОГО public-члена (доки уже богатые; добьём отдельным проходом). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Внешних codec-зависимостей нет: Deflate/Deflate64/BZip2/PPMd — собственные управляемые декодеры. -->

</Project>
