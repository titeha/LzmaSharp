<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 (анализатор xunit.v3) рекомендует передавать TestContext.Current.CancellationToken
         в вызовы, принимающие CancellationToken. Массовая замена изменила бы поведение тестов
         (отмена по таймауту раннера) и не относится к миграции пакетов, поэтому правило подавлено
         осознанно; внедрение отменяемых токенов — отдельная задача. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lzma.Ui\Lzma.Ui.csproj" />
    <ProjectReference Include="..\..\src\Lzma.Core\Lzma.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
