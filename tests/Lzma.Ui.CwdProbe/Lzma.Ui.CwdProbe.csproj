<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test-only проект-проба для шага A2 (F3 / AUD-005).
    Назначение: воспроизвести смену Environment.CurrentDirectory между SetVolumes и Commit
    в ИЗОЛИРОВАННОМ процессе, чтобы не менять глобальный CWD параллельного xUnit-раннера.
    Не является частью продукта, не упаковывается и не публикуется.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Lzma.Ui.CwdProbe</AssemblyName>
    <RootNamespace>Lzma.Ui.CwdProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lzma.Ui\Lzma.Ui.csproj" />
  </ItemGroup>

</Project>
