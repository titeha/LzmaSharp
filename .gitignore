###############################################################################
# LzmaSharp — .gitignore
#
# Только то, что реально создаётся инструментами этого репозитория:
# .NET/Avalonia (src, tests, bench), Visual Studio / Rider / VS Code, xUnit,
# нативная сборка vendor/lzma-sdk и мусор ОС.
#
# НЕ игнорируется намеренно (проектные данные, а не артефакты):
#   vendor/lzma-sdk/**                   — вендорный SDK (C/C++/Java/.mak/*.7z);
#   tests/**/*.7z, tests/**/*.001, .002  — тестовые многотомные архивы;
#   docs/**, bench/BASELINE.md, *.linq   — документация и LINQPad-скрипты.
#
# Локальные правила агентов (.clinerules/, .cline/, AGENTS.md) в репозиторий
# не входят — см. раздел «Агентские инструменты» внизу.
###############################################################################

# ── .NET / MSBuild: результаты сборки ────────────────────────────────────────
[Bb]in/
[Oo]bj/
artifacts/
BenchmarkDotNet.Artifacts/
*.binlog
project.lock.json
project.fragment.lock.json

# ── NuGet ────────────────────────────────────────────────────────────────────
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# ── Тесты и покрытие ─────────────────────────────────────────────────────────
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# ── Visual Studio / Rider / VS Code: пользовательские настройки ──────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user
*.sln.iml
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ── Профилировщик Visual Studio ──────────────────────────────────────────────
*.psess
*.vsp
*.vspx

# ── Нативная сборка vendor/lzma-sdk (nmake) ──────────────────────────────────
*.o
*.obj
*.a
*.lib
*.exp
*.ilk
*.pdb

# ── Логи и временное ─────────────────────────────────────────────────────────
*.log
*.tmp

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes

# ── Linux / редакторы ────────────────────────────────────────────────────────
*~
*.swp
.cache/

# ── Локальные секреты ────────────────────────────────────────────────────────
.env
*.pfx

# ── Публикация ───────────────────────────────────────────────────────────────
publish/


# ── Агентские инструменты (локальные, не часть проекта) ──────────────────────
# AGENTS.md исключён локально через .git/info/exclude.
# .clinerules/ и .cline/ — личные правила/скиллы агента, вне git.
.clinerules/
.cline/
.pi/
.pi-lens/
.serena/
.claude/
